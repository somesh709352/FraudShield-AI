# Backend Environment Variables
# Copy to .env for local development

# App
APP_NAME=FraudShield AI
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=sqlite:///./fraudshield.db

# API
API_HOST=0.0.0.0
API_PORT=8000

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Graph Analysis
GRAPH_MIN_TRANSACTIONS=5
GRAPH_SUSPICIOUS_THRESHOLD=0.7

# Statistics
STATS_ZSCORE_THRESHOLD=3.0
STATS_IQR_MULTIPLIER=1.5

# Bayesian
BAYESIAN_PRIOR_FRAUD=0.01

# Optimization
OPTIMIZATION_COST_FN=10000.0
OPTIMIZATION_COST_FP=100.0

# Quantum
QUANTUM_SHOTS=1024
QUANTUM_MAX_ITERATIONS=100